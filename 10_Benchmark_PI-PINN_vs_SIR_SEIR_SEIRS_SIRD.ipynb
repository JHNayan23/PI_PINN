    "        optimizer_physics.zero_grad()\n",
    "\n",
    "        t_colloc = (t_domain_min + (t_domain_max - t_domain_min) *\n",
    "                    torch.rand(n_collocation, 1, device=device))\n",
    "        t_colloc.requires_grad_(True)\n",
    "\n",
    "        S_hat = net_data(t_colloc)[:, 0:1]\n",
    "        I_hat = net_data(t_colloc)[:, 1:2]\n",
    "        R_hat = net_data(t_colloc)[:, 2:3]\n",
    "        E_hat = net_physics(t_colloc)\n",
    "\n",
    "        beta, gamma, sigma = net_physics.params['beta'], net_physics.params['gamma'], net_physics.params['sigma']\n",
    "\n",
    "        dS_dt = torch.autograd.grad(S_hat, t_colloc, grad_outputs=torch.ones_like(S_hat), create_graph=True)[0]\n",
    "        dI_dt = torch.autograd.grad(I_hat, t_colloc, grad_outputs=torch.ones_like(I_hat), create_graph=True)[0]\n",
