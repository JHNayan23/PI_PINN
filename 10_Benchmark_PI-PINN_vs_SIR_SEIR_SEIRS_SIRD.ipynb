    "class SEIRDataNet(nn.Module):\n",
    "    \n",
    "    def __init__(self, input_dim=1, hidden_dims=(50, 50, 50), output_dim=3):\n",
    "        super().__init__()\n",
    "        layers, in_dim = [], input_dim\n",
    "        for h in hidden_dims:\n",
    "            layers += [nn.Linear(in_dim, h), nn.Tanh()]\n",
    "            in_dim = h\n",
    "        layers += [nn.Linear(in_dim, output_dim)]\n",
    "        self.network = nn.Sequential(*layers)\n",
    "        for layer in self.network:\n",
    "            if isinstance(layer, nn.Linear):\n",
    "                xavier_uniform_(layer.weight)\n",
    "                nn.init.constant_(layer.bias, 0)\n",
    "\n",
    "    def forward(self, t):\n",
    "        return self.network(t)   # columns: [S, I, R]\n",
    "\n",
    "\n",
    "class SEIRPhysicsNet(nn.Module):\n",
    "    \n",
    "    def __init__(self, input_dim=1, hidden_dims=(50, 50, 50), output_dim=1):\n",
    "        super().__init__()\n",
    "        layers, in_dim = [], input_dim\n",
    "        for h in hidden_dims:\n",
    "            layers += [nn.Linear(in_dim, h), nn.Tanh()]\n",
    "            in_dim = h\n",
    "        layers += [nn.Linear(in_dim, output_dim)]\n",
    "        self.network = nn.Sequential(*layers)\n",
    "        for layer in self.network:\n",
    "            if isinstance(layer, nn.Linear):\n",
    "                xavier_uniform_(layer.weight)\n",
    "                nn.init.constant_(layer.bias, 0)\n",
    "\n",
    "        self.params = nn.ParameterDict({\n",
    "            'beta':  nn.Parameter(torch.tensor(1.0, dtype=torch.float32)),\n",
    "            'gamma': nn.Parameter(torch.tensor(1.0, dtype=torch.float32)),\n",
    "            'sigma': nn.Parameter(torch.tensor(1.0, dtype=torch.float32)),\n",
    "        })\n",
    "\n",
    "    def forward(self, t):\n",
    "        return self.network(t)   # column: [E]\n",
    "\n",
    "\n",
    "def train_split_pinn_seir(net_data, net_physics, optimizer_data, optimizer_physics,\n",
    "                           train_loader_local,\n",
    "                           t_val_tensor, S_val_tensor, I_val_tensor, R_val_tensor,\n",
    "                           t_domain_min, t_domain_max, n_collocation,\n",
    "                           epochs_data=EPOCHS_DATA, epochs_physics=EPOCHS_PHYSICS,\n",
    "                           device='cpu', verbose=True):\n",
    "    \n",
    "\n",
    "    # ---- STEP 1: data-only fit on S, I, R ----\n",
    "    data_train_losses, data_val_losses = [], []\n",
    "    best_val, wait = float('inf'), 0\n",
    "    for epoch in range(epochs_data):\n",
    "        net_data.train()\n",
    "        batch_losses = []\n",
    "        for t_batch, S_batch, I_batch, R_batch in train_loader_local:\n",
    "            optimizer_data.zero_grad()\n",
    "            out = net_data(t_batch)\n",
    "            S_hat, I_hat, R_hat = out[:, 0:1], out[:, 1:2], out[:, 2:3]\n",
    "            loss = (torch.mean((S_hat - S_batch) ** 2) +\n",
    "                    torch.mean((I_hat - I_batch) ** 2) +\n",
    "                    torch.mean((R_hat - R_batch) ** 2))\n",
    "            loss.backward()\n",
    "            optimizer_data.step()\n",
    "            batch_losses.append(loss.item())\n",
    "        epoch_loss = sum(batch_losses) / len(batch_losses)\n",
    "        data_train_losses.append(epoch_loss)\n",
    "\n",
    "        net_data.eval()\n",
    "        with torch.no_grad():\n",
    "            out_val = net_data(t_val_tensor)\n",
    "            val_loss = (torch.mean((out_val[:, 0:1] - S_val_tensor) ** 2) +\n",
    "                        torch.mean((out_val[:, 1:2] - I_val_tensor) ** 2) +\n",
    "                        torch.mean((out_val[:, 2:3] - R_val_tensor) ** 2))\n",
    "            data_val_losses.append(val_loss.item())\n",
    "\n",
    "        \n",
    "        if verbose and epoch % 500 == 0:\n",
    "            print(f'  [Step 1] Epoch {epoch:5d} | data_loss: {epoch_loss:.6f} | val_loss: {val_loss.item():.6f}')\n",
    "\n",
    "    for p in net_data.parameters():\n",
    "        p.requires_grad_(False)\n",
    "    net_data.eval()\n",
    "    if verbose:\n",
